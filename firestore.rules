rules_version = '2';

// Lygo's Land — Firestore security rules.
//
// PASTE THESE INTO: Firebase console -> Firestore Database -> Rules -> Publish
//
// This is the ONLY thing protecting user data. The apiKey in auth.js is a
// public project identifier, not a secret — anyone can read it from your page
// source. These rules are what stop one signed-in user reading another's data.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns exactly one document, named after their auth uid.
    match /users/{uid} {

      // You can only touch your own document, and only while signed in.
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Writes additionally have to look like profile data, so a compromised
      // client can't stuff arbitrary junk into the database.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validProfileDoc();
    }

    function validProfileDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['profiles', 'activeId', 'updated', 'schema'])
             && d.profiles is list
             && d.profiles.size() <= 8          // matches MAX_PROFILES
             && (!('activeId' in d) || d.activeId == null || d.activeId is string);
    }

    // Anything not matched above is denied. Do not add a catch-all.
  }
}
